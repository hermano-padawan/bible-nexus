---
const questions=[
  ["A difficult decision appears. What do you do?",[["Pray, then act courageously","David"],["Study every consequence","Esther"],["Keep working faithfully","Joseph"],["Move quickly and learn","Peter"]]],
  ["Someone treats you unfairly. What response feels most natural?",[["Leave justice with God","David"],["Choose careful words","Esther"],["Forgive without denying the wrong","Joseph"],["Confront it directly","Peter"]]],
  ["Your community faces a crisis. Where do you contribute?",[["I step forward","David"],["I build a thoughtful plan","Esther"],["I organize practical help","Joseph"],["I rally people immediately","Peter"]]],
  ["What quality do you value most?",[["Courage","David"],["Wisdom","Esther"],["Perseverance","Joseph"],["Honesty","Peter"]]],
  ["When a plan fails, you usually…",[["Try again with faith","David"],["Pause and reassess","Esther"],["Stay steady for the long term","Joseph"],["Admit it and restart","Peter"]]],
  ["Which setting brings out your best?",[["A demanding challenge","David"],["A delicate conversation","Esther"],["A complex responsibility","Joseph"],["A team in motion","Peter"]]],
  ["A friend needs help. You are most likely to…",[["Defend them","David"],["Advocate tactfully","Esther"],["Provide what they need","Joseph"],["Show up immediately","Peter"]]],
  ["What is hardest for you?",[["Waiting instead of acting","David"],["Speaking before the right moment","Esther"],["Trusting through a long delay","Joseph"],["Thinking before speaking","Peter"]]],
  ["How do you tend to lead?",[["By example","David"],["Through influence","Esther"],["Through preparation","Joseph"],["With visible enthusiasm","Peter"]]],
  ["What kind of growth matters most right now?",[["A braver faith","David"],["Greater discernment","Esther"],["Patient faithfulness","Joseph"],["Humility after mistakes","Peter"]]],
] as const;
const results={David:"You tend toward courageous action and honest dependence on God. David's story also reminds us that courage needs humility and correction.",Esther:"You value discernment, timing, and purposeful courage. Esther's story shows how thoughtful action can serve others.",Joseph:"You lean toward perseverance, responsibility, and forgiveness. Joseph's life shows faithfulness across long and difficult seasons.",Peter:"You bring energy, openness, and willingness to begin again. Peter's story shows that failure does not have to be the final word."};
---
<section class="personality" data-personality><div class="quiz-status"><span data-personality-progress>Question 1 of {questions.length}</span></div><article class="quiz-card" data-personality-card><p class="eyebrow">A reflective Bible game</p><h2 data-personality-question></h2><div class="quiz-answers" data-personality-answers></div></article><article class="quiz-result" data-personality-result hidden><p class="eyebrow">Your closest match</p><strong data-personality-name></strong><p data-personality-copy></p><small>This is a lighthearted reflection, not a psychological or spiritual assessment.</small><div><button type="button" data-personality-retry>Play again</button></div></article></section>
<script is:inline type="application/json" data-personality-data set:html={JSON.stringify({questions,results})}></script>
<script>
  const personalityRoot=document.querySelector<HTMLElement>("[data-personality]");const personalitySource=document.querySelector<HTMLScriptElement>("[data-personality-data]");if(personalityRoot&&personalitySource){const data=JSON.parse(personalitySource.textContent||"{}") as {questions:[string,[string,string][]][],results:Record<string,string>};let current=0;const scores:Record<string,number>={David:0,Esther:0,Joseph:0,Peter:0};const one=<T extends Element>(s:string)=>personalityRoot.querySelector<T>(s);const set=(s:string,v:string)=>{const e=one<HTMLElement>(s);if(e)e.textContent=v};const render=()=>{const [question,answers]=data.questions[current];set("[data-personality-progress]",`Question ${current+1} of ${data.questions.length}`);set("[data-personality-question]",question);const box=one<HTMLElement>("[data-personality-answers]")!;box.innerHTML="";answers.forEach(([answer,name])=>{const b=document.createElement("button");b.type="button";b.textContent=answer;b.addEventListener("click",()=>{scores[name]=(scores[name]||0)+1;current++;if(current<data.questions.length)render();else finish()});box.append(b)})};const finish=()=>{const name=Object.entries(scores).sort((a,b)=>b[1]-a[1])[0][0];one<HTMLElement>("[data-personality-card]")!.hidden=true;one<HTMLElement>("[data-personality-result]")!.hidden=false;set("[data-personality-name]",name);set("[data-personality-copy]",data.results[name])};one<HTMLButtonElement>("[data-personality-retry]")?.addEventListener("click",()=>{current=0;Object.keys(scores).forEach(k=>scores[k]=0);one<HTMLElement>("[data-personality-result]")!.hidden=true;one<HTMLElement>("[data-personality-card]")!.hidden=false;render()});render()}
</script>
