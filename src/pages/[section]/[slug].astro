---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { absoluteUrl, sectionBySlug } from "../../config";
export async function getStaticPaths(){const all=await getCollection("articles");return all.map(entry=>({params:{section:entry.data.section,slug:entry.id},props:{entry,all}}));}
const { entry, all }=Astro.props;const { Content }=await render(entry);const section=sectionBySlug.get(entry.data.section);const related=entry.data.related.map((id:string)=>all.find((item:any)=>item.id===id)).filter(Boolean);const canonical=`/${entry.data.section}/${entry.id}/`;const schema={"@context":"https://schema.org","@type":"Article",headline:entry.data.title,description:entry.data.description,datePublished:entry.data.published.toISOString(),dateModified:(entry.data.updated??entry.data.published).toISOString(),mainEntityOfPage:absoluteUrl(canonical),publisher:{"@type":"Organization",name:"Bible Nexus",url:"https://biblenexus.site"}};
---
<BaseLayout title={entry.data.seoTitle??entry.data.title} description={entry.data.seoDescription??entry.data.description} canonical={canonical} type="article" spanishEquivalent={entry.data.spanishEquivalent}>
<article><header class="article-header article-shell"><div class="breadcrumbs"><a href="/">Home</a> / <a href={`/${entry.data.section}/`}>{section?.label}</a></div><p class="eyebrow">{section?.label}</p><h1>{entry.data.title}</h1><p class="hero-copy">{entry.data.description}</p><p class="article-meta">Published {entry.data.published.toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric"})}</p></header><div class="article-body article-shell">{entry.data.bibleReferences.length>0&&<aside class="category-card"><strong>Bible references:</strong> {entry.data.bibleReferences.join(" · ")}</aside>}<Content/></div></article>
{related.length>0&&<section class="section alt"><div class="container"><div class="section-head"><h2>Keep reading</h2></div><div class="card-grid">{related.map((item:any)=><ContentCard entry={item}/>)}</div></div></section>}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
</BaseLayout>
