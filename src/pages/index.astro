---
import{getCollection}from"astro:content";import BaseLayout from"../layouts/BaseLayout.astro";import ContentCard from"../components/ContentCard.astro";import{sections,withBase}from"../config";const articles=await getCollection("articles");const featured=articles.filter(a=>a.data.featured).slice(0,6);const icons=["☀","◌","♡","✦","♧","⌂","?","A"];
---
<BaseLayout><section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Faith for everyday life</p><h1>Hope for today. Truth you can hold on to.</h1><p class="hero-copy">Read simple Bible messages, find words for prayer, and take a quiet moment with God. You do not have to have everything figured out to begin.</p><a class="button" href={withBase("/devotionals/")}>Read a devotional</a></div><div class="hero-note">“God is our refuge and strength, an ever-present help in trouble.”<br><small>Psalm 46:1</small></div></div></section><section class="section"><div class="container"><div class="section-head"><div><p class="eyebrow">Find what you need</p><h2>Explore Bible Nexus</h2></div></div><div class="category-grid">{sections.map((s,i)=><a class="category-card" href={withBase(`/${s.slug}/`)}><span>{icons[i]}</span><h3>{s.label}</h3><p>{s.description}</p></a>)}</div></div></section><section class="section alt"><div class="container"><div class="section-head"><div><p class="eyebrow">Read and share</p><h2>Words for the road ahead</h2></div></div><div class="card-grid">{featured.map(entry=><ContentCard entry={entry}/>)}</div></div></section></BaseLayout>
